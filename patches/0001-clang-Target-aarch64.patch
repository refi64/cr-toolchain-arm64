From 4865ea6398d5686ad459e0ea77dae6d4f3359e70 Mon Sep 17 00:00:00 2001
From: Ryan Gonzalez <git@refi64.dev>
Date: Wed, 13 Sep 2023 09:31:07 -0500
Subject: [PATCH 1/3] clang: Target aarch64

---
 tools/clang/scripts/build.py | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/tools/clang/scripts/build.py b/tools/clang/scripts/build.py
index 72a8a8eceed..b73ccebdce1 100755
--- a/tools/clang/scripts/build.py
+++ b/tools/clang/scripts/build.py
@@ -413,6 +413,7 @@ def WriteGitCommitInfo(git_repository, commit, tz):
 
 def AddCMakeToPath():
   """Download CMake and add it to PATH."""
+  return
   if sys.platform == 'win32':
     zip_name = 'cmake-3.26.4-windows-x86_64.zip'
     dir_name = ['cmake-3.26.4-windows-x86_64', 'bin']
@@ -1158,11 +1159,11 @@ def main():
 
   if sys.platform.startswith('linux'):
     with timer.time('get sysroots'):
-      sysroot_amd64 = DownloadDebianSysroot('amd64', args.skip_checkout)
-      sysroot_i386 = DownloadDebianSysroot('i386', args.skip_checkout)
-      sysroot_arm = DownloadDebianSysroot('arm', args.skip_checkout)
+      sysroot_amd64 = ''
+      sysroot_i386 = ''
+      sysroot_arm = ''
       sysroot_arm64 = DownloadDebianSysroot('arm64', args.skip_checkout)
-      sysroot_riscv64 = DownloadDebianSysroot('riscv64', args.skip_checkout)
+      sysroot_riscv64 = ''
 
   if args.skip_build:
     return 0
@@ -1179,7 +1180,7 @@ def main():
   cxxflags = []
   ldflags = []
 
-  targets = 'AArch64;ARM;LoongArch;Mips;PowerPC;RISCV;SystemZ;WebAssembly;X86'
+  targets = 'AArch64;WebAssembly'
   projects = 'clang;lld'
   if not args.no_tools:
     projects += ';clang-tools-extra'
@@ -1904,6 +1905,8 @@ def main():
   # -DLLVM_BUILTIN_TARGETS/-DLLVM_RUNTIME_TARGETS.
   all_triples = ''
   for triple in sorted(runtimes_triples_args.keys()):
+    if triple != 'aarch64-unknown-linux-gnu':
+      continue
     all_triples += triple + ';'
     for arg in runtimes_triples_args[triple]["args"]:
       assert not arg.startswith('-')
-- 
